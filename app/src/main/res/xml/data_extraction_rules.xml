<?xml version="1.0" encoding="utf-8"?>
<!-- The session token is encrypted with a key held in Android Keystore, which
     never leaves the device, so backed-up settings would be useless. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
